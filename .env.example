# ---- Instagram (API with Instagram Login — no Facebook Page needed) ----
# Generated in the Meta App Dashboard: Instagram -> API setup with
# Instagram Login -> add her Instagram account -> Generate Token.
IG_ACCESS_TOKEN=your_instagram_access_token
# Any string you choose — Meta echoes this back to prove the webhook is yours
IG_VERIFY_TOKEN=pick_a_random_string
# Graph API version to call — check developers.facebook.com for the current one
GRAPH_API_VERSION=v21.0

# ---- Supabase (persistent storage for slots/bookings/conversations) ----
# Project Settings -> API in your Supabase dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ---- Claude ----
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-6

# ---- Shop info (fed into the system prompt — edit freely) ----
SHOP_NAME=Placeholder Tattoo Co.
SHOP_CITY=Reno/Sparks, NV
SHOP_HOURS=Tue-Sat, 11am-7pm
SHOP_STYLES=fine line, black & grey realism, traditional, cover-ups
SHOP_DEPOSIT=$50 non-refundable deposit due at booking
SHOP_PRICING=$150/hr shop minimum, custom quotes for large pieces

PORT=3000
